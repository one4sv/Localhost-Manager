<UserControl x:Class="LocalhostManager.Controls.ProjectForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">

    <Border Background="{DynamicResource SurfaceSecondaryBrush}"
            CornerRadius="14"
            Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="{DynamicResource ProjectName}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="2,0,0,5"/>

                <TextBox x:Name="ProjectNameTextBox"/>

            </StackPanel>

            <StackPanel Grid.Row="1"
                        Margin="0,10,0,0">

                <TextBlock Text="{DynamicResource ProjectDescription}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="2,0,0,5"/>

                <TextBox x:Name="ProjectDescriptionTextBox"/>

            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">

                <Button Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="Cancel_Click">

                    <TextBlock Text="{DynamicResource Cancel}"/>

                </Button>

                <Button x:Name="SaveButton"
                        Width="100"
                        Height="36"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click">

                    <TextBlock Text="{DynamicResource Add}"/>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>