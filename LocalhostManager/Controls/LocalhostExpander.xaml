<UserControl x:Class="LocalhostManager.Controls.LocalhostExpander"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">

    <Border Margin="0,0,0,10">

        <Expander x:Name="LocalhostExpanderControl">

            <Expander.Header>

                <Grid Height="52">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding Name}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceTertiaryBrush}"
                            CornerRadius="10"
                            Padding="9,5"
                            Margin="8,0,0,0"
                            Height="34">

                        <TextBlock FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SecondaryTextBrush}"/>

                                    <Setter Property="Text"
                                            Value="{DynamicResource Stopped}"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsRunning}"
                                                     Value="True">

                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource PrimaryBrush}"/>

                                            <Setter Property="Text"
                                                    Value="{DynamicResource Running}"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Border>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">

                        <Button Width="78"
                                Height="34"
                                ToolTip="{DynamicResource Start}"
                                Click="StartLocalhost_Click">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource SmallPrimaryButton}">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsRunning}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                            <TextBlock Text="▶"/>

                        </Button>

                        <Button Width="36"
                                Height="34"
                                ToolTip="{DynamicResource Stop}"
                                Click="StopLocalhost_Click">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource SmallDangerButton}">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsRunning}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                            <TextBlock Text="■"/>

                        </Button>

                        <Button Width="36"
                                Height="34"
                                Margin="6,0,0,0"
                                ToolTip="{DynamicResource Restart}"
                                Click="RestartLocalhost_Click">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource SmallButton}">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsRunning}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                            <TextBlock Text="↻"/>

                        </Button>

                    </StackPanel>

                    <Button Grid.Column="3"
                            Width="82"
                            Height="34"
                            Margin="8,0,12,0"
                            ToolTip="{DynamicResource Open}"
                            Click="OpenLocalhost_Click">

                        <TextBlock Text="{DynamicResource Open}"/>

                    </Button>

                </Grid>

            </Expander.Header>

            <StackPanel Margin="52,0,0,14">

                <TextBlock Text="{Binding Path}"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,10"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Height="36"
                              ItemsSource="{Binding Commands}"
                              SelectedItem="{Binding Command,
                                  UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{DynamicResource Command}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Url}"
                               Foreground="{DynamicResource LinkBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,12,0"
                               TextTrimming="CharacterEllipsis"/>

                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">

                    <Button Width="120"
                            Height="34"
                            Margin="0,0,6,0"
                            ToolTip="{DynamicResource Logs}"
                            Click="ShowLogs_Click">

                        <TextBlock Text="{DynamicResource Logs}"/>

                    </Button>

                    <Button Width="90"
                            Height="34"
                            Margin="0,0,6,0"
                            ToolTip="{DynamicResource Edit}"
                            Click="EditLocalhost_Click">

                        <TextBlock Text="{DynamicResource Edit}"/>

                    </Button>

                    <Button Width="82"
                            Height="34"
                            Style="{StaticResource DangerButton}"
                            ToolTip="{DynamicResource Delete}"
                            Click="DeleteLocalhost_Click">

                        <TextBlock Text="{DynamicResource Delete}"/>

                    </Button>

                </StackPanel>

            </StackPanel>

        </Expander>

    </Border>

</UserControl>