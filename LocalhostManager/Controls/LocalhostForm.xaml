<UserControl x:Class="LocalhostManager.Controls.LocalhostForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">

    <Border Background="{DynamicResource SurfaceSecondaryBrush}"
            CornerRadius="14"
            Padding="16">

        <StackPanel>

            <TextBlock x:Name="LocalhostTitle"
                       Text="{DynamicResource NewLocalhost}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,14"/>

            <TextBlock Text="{DynamicResource Name}"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="NameTextBox"
                     Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Description}"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="DescriptionTextBox"
                     Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Path}"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PathTextBox"/>

                <Button Grid.Column="1"
                        Content="..."
                        Width="48"
                        Margin="8,0,0,0"
                        ToolTip="{DynamicResource Path}"
                        Click="SelectPath_Click"/>

            </Grid>

            <TextBlock Text="{DynamicResource Command}"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="CommandComboBox"
                      Margin="0,0,0,8"
                      SelectionChanged="CommandComboBox_SelectionChanged"/>

            <StackPanel x:Name="CustomCommandPanel"
                        Visibility="Collapsed"
                        Margin="0,0,0,12">

                <TextBlock Text="{DynamicResource CustomCommand}"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="CustomCommandTextBox"
                         Margin="0,0,0,10"/>

                <CheckBox x:Name="SaveCustomCommandCheckBox"
                          Content="{DynamicResource SaveCustomCommand}"
                          IsChecked="True"/>

            </StackPanel>

            <TextBlock Text="{DynamicResource Port}"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="PortTextBox"
                     Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Url}"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="UrlTextBox"
                     Margin="0,0,0,14"/>

            <Button Content="{DynamicResource DetectCommands}" Click="Detect_Click" Margin="0,0,0,12"/>
            <Expander Header="{DynamicResource ServiceAdvanced}" Margin="0,0,0,14">
                <StackPanel Margin="12">
                    <TextBlock Text="{DynamicResource HealthAddress}" TextWrapping="Wrap"/>
                    <TextBox x:Name="HealthTextBox" Margin="0,6,0,12"/>
                    <TextBlock Text="{DynamicResource StartupOrder}"/>
                    <TextBox x:Name="OrderTextBox" Text="0" Margin="0,6,0,12"/>
                    <TextBlock Text="{DynamicResource ReadyTimeout}"/>
                    <TextBox x:Name="TimeoutTextBox" Text="30" Margin="0,6,0,12"/>
                    <TextBlock Text="{DynamicResource StopCommand}"/>
                    <TextBox x:Name="StopTextBox" Margin="0,6,0,12"/>
                    <TextBlock Text="{DynamicResource StopHelp}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <CheckBox x:Name="RestartCheckBox" Content="{DynamicResource CrashRetry}"/>
                    <Button Content="{DynamicResource InspectPort}" Click="CheckPort_Click" Margin="0,12,0,0"/>
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Width="100"
                        Margin="0,0,8,0"
                        Click="Cancel_Click">

                    <TextBlock Text="{DynamicResource Cancel}"/>

                </Button>

                <Button x:Name="AddButton"
                        Width="100"
                        Style="{StaticResource PrimaryButton}"
                        Click="Add_Click">

                    <TextBlock Text="{DynamicResource Add}"/>

                </Button>

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>