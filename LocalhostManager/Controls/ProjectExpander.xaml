<UserControl x:Class="LocalhostManager.Controls.ProjectExpander"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LocalhostManager.Controls">

    <Border Margin="0,0,0,6">

        <Expander x:Name="ProjectExpanderControl">

            <Expander.Header>

                <Grid Height="72"
                      Margin="4,0,12,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding Name}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,8,0">

                        <Button Width="120"
                                Height="36"
                                Click="StartProject_Click">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource SmallPrimaryButton}">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsRunning}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                            <TextBlock Text="{DynamicResource Start}"/>

                        </Button>

                        <Button Width="120"
                                Height="36"
                                Click="StopProject_Click">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource SmallDangerButton}">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsRunning}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                            <TextBlock Text="{DynamicResource Stop}"/>

                        </Button>

                        <Button Width="36"
                                Height="36"
                                Margin="6,0,0,0"
                                ToolTip="{DynamicResource Restart}"
                                Click="RestartProject_Click">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource SmallButton}">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsRunning}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                            <TextBlock Text="↻"/>

                        </Button>

                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Width="90"
                                Height="36"
                                Margin="0,0,6,0"
                                Click="EditProject_Click">

                            <TextBlock Text="{DynamicResource Edit}"/>

                        </Button>

                        <Button Width="82"
                                Height="36"
                                Style="{StaticResource DangerButton}"
                                Click="DeleteProject_Click">

                            <TextBlock Text="{DynamicResource Delete}"/>

                        </Button>

                    </StackPanel>

                </Grid>

            </Expander.Header>

            <StackPanel>

                <controls:ProjectForm x:Name="ProjectForm"
                                      Visibility="Collapsed"
                                      ProjectCreated="ProjectForm_ProjectCreated"
                                      ProjectEdited="ProjectForm_ProjectEdited"
                                      Cancelled="ProjectForm_Cancelled"
                                      Margin="0,0,0,14"/>

                <Button Width="185"
                        Height="36"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Click="AddLocalhost_Click">

                    <TextBlock Text="{DynamicResource AddLocalhost}"/>

                </Button>

                <controls:LocalhostForm
                    x:Name="LocalhostForm"
                    LocalhostCreated="LocalhostForm_LocalhostCreated"
                    LocalhostEdited="LocalhostForm_LocalhostEdited"
                    Cancelled="LocalhostForm_Cancelled"
                    Visibility="{Binding IsAddingLocalhost,
                        Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,14"/>

                <ItemsControl ItemsSource="{Binding Localhosts}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <controls:LocalhostExpander
                                DataContext="{Binding}"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </Expander>

    </Border>

</UserControl>